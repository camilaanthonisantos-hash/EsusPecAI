# ==========================================
# e-SUS PEC AI - Variáveis de Ambiente
# Domínio de Produção: peccapsai.mentoriajrs.com
# ==========================================

# Porta da aplicação (padrão 3000)
PORT=3000
NODE_ENV=production

# URL da aplicação pública (usada para links e integrações)
APP_URL="https://peccapsai.mentoriajrs.com"

# Chaves de API das IAs (Preencha as que você utiliza)
GEMINI_API_KEY="AIzaSy..."
OPENAI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# (Opcional) Desativar HMR em desenvolvimento se necessário
DISABLE_HMR=false
