{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FirebaseBlueprint",
  "description": "Schema representation for PEC Prontuário Multiprofissional Firestore database",
  "entities": {
    "User": {
      "collection": "users",
      "description": "Healthcare professionals and system administrators registered in the system",
      "fields": {
        "id": { "type": "string", "description": "User UID" },
        "name": { "type": "string", "description": "Full name of professional" },
        "email": { "type": "string", "description": "Professional email address" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "Role: admin (full system privileges) or user (standard professional)" },
        "profession": { "type": "string", "description": "Profession ID (enfermeiro, medico, psicologo, etc.)" },
        "professionalRegister": { "type": "string", "description": "Council register (CRM, COREN, CRP, etc.)" },
        "workplace": { "type": "string", "description": "Health unit / UBS / CAPS / eMulti" },
        "avatarUrl": { "type": "string", "description": "Optional avatar URL" },
        "googleCalendarId": { "type": "string", "description": "Google Calendar secondary/primary ID for appointment sync" },
        "isBookingEnabled": { "type": "boolean", "description": "Whether professional accepts public bookings" },
        "isChargingEnabled": { "type": "boolean", "description": "Whether professional requires payment/PIX before confirmation" },
        "scheduleConfig": { "type": "object", "description": "Weekly availability schedule and slot durations" },
        "customServices": { "type": "array", "description": "Catalog of services with duration and prices" },
        "createdAt": { "type": "number", "description": "Creation timestamp" }
      },
      "required": ["name", "email", "role", "profession", "professionalRegister", "workplace"]
    },
    "SystemSettings": {
      "collection": "system_settings",
      "description": "Global system configurations managed by system admin",
      "fields": {
        "geminiApiKey": { "type": "string", "description": "Global Gemini API key for fallback/shared execution" },
        "defaultModel": { "type": "string", "description": "Default Gemini model for PEC generation" },
        "defaultCiapCode": { "type": "string", "description": "Default CIAP-2 code for consultation finalization" },
        "defaultSigtapCode": { "type": "string", "description": "Default SIGTAP code for health orientation" },
        "municipalityName": { "type": "string", "description": "Municipal health authority name" },
        "defaultUnitName": { "type": "string", "description": "Default health unit name" },
        "systemCustomInstructions": { "type": "string", "description": "Custom prompt directives injected into AI" },
        "allowUserSelfRegister": { "type": "boolean", "description": "Whether new users can register as standard users" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" },
        "updatedBy": { "type": "string", "description": "Admin email who updated settings" }
      },
      "required": ["defaultModel", "defaultCiapCode", "defaultSigtapCode", "municipalityName"]
    },
    "Patient": {
      "collection": "patients",
      "description": "Patients registered in primary care / health network",
      "fields": {
        "id": { "type": "string", "description": "Patient UUID" },
        "fullName": { "type": "string", "description": "Full name" },
        "cns": { "type": "string", "description": "Cartão Nacional de Saúde (15 digits)" },
        "cpf": { "type": "string", "description": "CPF document" },
        "birthDate": { "type": "string", "description": "Birth date YYYY-MM-DD" },
        "gender": { "type": "string", "description": "Gender identity" },
        "phone": { "type": "string", "description": "Contact phone" },
        "address": { "type": "string", "description": "Address" },
        "legalGuardianName": { "type": "string", "description": "Legal guardian name for minors/dependents" },
        "guardianKinship": { "type": "string", "description": "Kinship relation" },
        "guardianKinshipCustom": { "type": "string", "description": "Custom kinship note" },
        "createdAt": { "type": "number", "description": "Registration timestamp" },
        "updatedAt": { "type": "number", "description": "Last updated timestamp" }
      },
      "required": ["fullName", "cns", "birthDate"]
    },
    "Consultation": {
      "collection": "consultations",
      "description": "Consolidated PEC consultation records",
      "fields": {
        "id": { "type": "string", "description": "Record ID" },
        "patientId": { "type": "string", "description": "Foreign key to Patient" },
        "patientName": { "type": "string", "description": "Patient display name" },
        "authorId": { "type": "string", "description": "User ID of author" },
        "authorName": { "type": "string", "description": "Author full name" },
        "authorProfession": { "type": "string", "description": "Profession ID" },
        "authorRegister": { "type": "string", "description": "Professional council register" },
        "workplace": { "type": "string", "description": "UBS / Health Unit" },
        "timestamp": { "type": "number", "description": "Consultation date and time" },
        "isFirstConsultation": { "type": "boolean", "description": "Whether it is first consultation / intake or return" },
        "clinicalAudit": { "type": "string", "description": "Cross-checked audit alerts from previous visits" },
        "avaliacao": { "type": "string", "description": "PEC Field 1: Avaliação" },
        "plano": { "type": "string", "description": "PEC Field 2: Plano" },
        "conduta": { "type": "string", "description": "PEC Field 3: Conduta (Enfermeiro)" },
        "rawNotes": { "type": "string", "description": "Raw dictation or summary notes" },
        "modelUsed": { "type": "string", "description": "Gemini model identifier" },
        "prescription": { "type": "object", "description": "Prescription / Transcription data in 2-copy A4 landscape format" },
        "referral": { "type": "object", "description": "Guia de Encaminhamento e Referência SUS" },
        "pts": { "type": "object", "description": "Projeto Terapêutico Singular multiprofissional" }
      },
      "required": ["patientId", "patientName", "authorName", "authorProfession", "avaliacao", "plano", "timestamp"]
    },
    "KnowledgeItem": {
      "collection": "knowledge_items",
      "description": "Municipal health protocols, REMUME, and clinical guides",
      "fields": {
        "id": { "type": "string", "description": "Knowledge document ID" },
        "title": { "type": "string", "description": "Protocol title" },
        "category": { "type": "string", "description": "Category (remume, protocolo_aps, raps, personalizado)" },
        "content": { "type": "string", "description": "Protocol markdown or text" },
        "isActive": { "type": "boolean", "description": "Active in prompt injection" },
        "isSystemDefault": { "type": "boolean", "description": "Built-in standard protocol" },
        "createdAt": { "type": "number", "description": "Creation timestamp" }
      },
      "required": ["title", "category", "content"]
    },
    "Medication": {
      "collection": "medications",
      "description": "SUS / RENAME / REMUME public health medication catalog for automatic prescription pre-filling",
      "fields": {
        "id": { "type": "string", "description": "Medication unique ID" },
        "name": { "type": "string", "description": "Active substance / DCB name" },
        "concentration": { "type": "string", "description": "Dosage / concentration (e.g. 500 mg, 100 UI/ml)" },
        "pharmaceuticalForm": { "type": "string", "description": "Pharmaceutical form (Comprimido, Suspensão, Ampola, Pomada)" },
        "fullName": { "type": "string", "description": "Full standard prescription name" },
        "route": { "type": "string", "description": "Default administration route (USO ORAL, USO IM, USO TÓPICO, etc.)" },
        "defaultPosology": { "type": "string", "description": "Standard suggested posology" },
        "defaultDuration": { "type": "string", "description": "Standard duration" },
        "defaultSchedule": { "type": "string", "description": "Standard administration hours" },
        "component": { "type": "string", "description": "SUS Component (Farmácia Básica, RAPS, Especializado, Estratégico)" },
        "controlCategory": { "type": "string", "description": "Prescription / control category (Receita Simples, Antimicrobiano, C1, B)" },
        "therapeuticClass": { "type": "string", "description": "Therapeutic classification" },
        "instructions": { "type": "string", "description": "Patient care instructions and precautions" },
        "keywords": { "type": "array", "description": "Search aliases and trade names" },
        "isRemumeDefault": { "type": "boolean", "description": "Whether it is in default municipal REMUME" },
        "active": { "type": "boolean", "description": "Active status for clinical selection" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" }
      },
      "required": ["name", "concentration", "fullName", "route", "component", "controlCategory"]
    },
    "Exam": {
      "collection": "exams",
      "description": "SUS official laboratory and imaging exams catalog for clinical orders",
      "fields": {
        "id": { "type": "string", "description": "Exam unique ID" },
        "name": { "type": "string", "description": "Official exam title" },
        "category": { "type": "string", "description": "Category (Laboratorial, Imagem, Cardiológico, Ginecológico/Obstétrico, Outros)" },
        "sigtapCode": { "type": "string", "description": "SIGTAP SIA procedure code" },
        "clinicalIndication": { "type": "string", "description": "Standard clinical indication" },
        "preparation": { "type": "string", "description": "Patient preparation instructions" },
        "keywords": { "type": "array", "description": "Search aliases and keywords" },
        "isDefault": { "type": "boolean", "description": "Built-in default exam" },
        "active": { "type": "boolean", "description": "Active status for clinical selection" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" }
      },
      "required": ["name", "category", "active"]
    },
    "Appointment": {
      "collection": "appointments",
      "description": "Unified clinical appointments integrated with Google Calendar and WhatsApp n8n",
      "fields": {
        "id": { "type": "string", "description": "Appointment unique ID" },
        "patientId": { "type": "string", "description": "Linked registered patient ID (optional)" },
        "patientName": { "type": "string", "description": "Patient full name" },
        "patientCpf": { "type": "string", "description": "Patient CPF document" },
        "patientPhone": { "type": "string", "description": "Patient WhatsApp phone number" },
        "patientEmail": { "type": "string", "description": "Patient email address" },
        "patientCns": { "type": "string", "description": "Patient Cartão SUS / CNS" },
        "patientBirthDate": { "type": "string", "description": "Patient birth date" },
        "professionalId": { "type": "string", "description": "Healthcare professional User UID" },
        "professionalName": { "type": "string", "description": "Healthcare professional full name" },
        "professionalEmail": { "type": "string", "description": "Healthcare professional email" },
        "professionalProfession": { "type": "string", "description": "Profession ID (enfermeiro, medico, etc.)" },
        "serviceId": { "type": "string", "description": "Service ID from professional catalog" },
        "serviceName": { "type": "string", "description": "Service display name" },
        "serviceDurationMinutes": { "type": "number", "description": "Service duration in minutes" },
        "servicePrice": { "type": "number", "description": "Service cost / price in R$" },
        "date": { "type": "string", "description": "Appointment date YYYY-MM-DD" },
        "startTime": { "type": "string", "description": "Start time HH:mm" },
        "endTime": { "type": "string", "description": "End time HH:mm" },
        "timestamp": { "type": "number", "description": "Start epoch timestamp in milliseconds" },
        "status": { "type": "string", "enum": ["agendado", "em_atendimento", "finalizado", "cancelado"], "description": "Appointment status" },
        "notes": { "type": "string", "description": "Notes or reason for consultation" },
        "googleCalendarEventId": { "type": "string", "description": "Google Calendar synced event ID" },
        "paymentStatus": { "type": "string", "enum": ["isento", "pendente", "pago", "reembolsado"], "description": "Payment status" },
        "paymentMethod": { "type": "string", "description": "Payment method (pix, gratuito, balcao, etc.)" },
        "pixQrCode": { "type": "string", "description": "PIX QR Code base64 / URL" },
        "pixCopiaECola": { "type": "string", "description": "PIX Copia e Cola EMV string" },
        "pixId": { "type": "string", "description": "PIX payment transaction reference ID" },
        "source": { "type": "string", "enum": ["portal_publico", "whatsapp_n8n", "interno"], "description": "Creation source" },
        "consultationId": { "type": "string", "description": "Linked consultation ID when attended" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" }
      },
      "required": ["patientName", "patientPhone", "professionalId", "serviceName", "date", "startTime", "endTime", "status"]
    },
    "Subscription": {
      "collection": "subscriptions",
      "description": "User subscription orders and PIX payment records with automatic expiration",
      "fields": {
        "id": { "type": "string", "description": "Subscription order unique ID" },
        "userId": { "type": "string", "description": "User UID" },
        "userName": { "type": "string", "description": "Full name of subscriber" },
        "userEmail": { "type": "string", "description": "Subscriber email" },
        "userCpf": { "type": "string", "description": "Subscriber CPF" },
        "userPhone": { "type": "string", "description": "Subscriber WhatsApp phone" },
        "planId": { "type": "string", "description": "Plan identifier" },
        "planName": { "type": "string", "description": "Plan name" },
        "amount": { "type": "number", "description": "Payment amount in R$" },
        "durationDays": { "type": "number", "description": "Plan validity in days" },
        "status": { "type": "string", "enum": ["pendente", "pago", "expirado", "cancelado"], "description": "Payment status" },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "expiresAt": { "type": "number", "description": "PIX expiration timestamp in milliseconds from n8n" },
        "expirationDate": { "type": "string", "description": "Human-readable expiration date string from n8n" },
        "pixQrCode": { "type": "string", "description": "PIX QR Code base64 / URL" },
        "pixCopiaECola": { "type": "string", "description": "PIX Copia e Cola EMV code" },
        "pixId": { "type": "string", "description": "PagBank PIX order reference ID" }
      },
      "required": ["userId", "userName", "planId", "amount", "status", "createdAt"]
    },
    "ClinicalEvolution": {
      "collection": "clinical_evolutions",
      "description": "Longitudinal clinical evolution analysis generated by AI with cascade model fallback",
      "fields": {
        "id": { "type": "string", "description": "Unique record ID (patientId)" },
        "patientId": { "type": "string", "description": "Linked registered patient ID" },
        "patientName": { "type": "string", "description": "Patient full name" },
        "generatedAt": { "type": "number", "description": "Timestamp when analysis was generated" },
        "modelUsed": { "type": "string", "description": "AI model that produced the analysis" },
        "totalConsultationsAnalyzed": { "type": "number", "description": "Count of consultations included" },
        "dateRange": { "type": "object", "description": "Start and end dates covered by analysis" },
        "resumoLongitudinal": { "type": "string", "description": "Detailed clinical synthesis guiding future consultations" },
        "matrizEvolucao": { "type": "object", "description": "Evolution matrix: psychoemotional, physical/vitals, family/social" },
        "pontosAlertaRecomendacoes": { "type": "array", "description": "Alert points and team recommendations (PTS)" },
        "condutasRealizadas": { "type": "object", "description": "Prescriptions, exam requests, referrals, medical reports, attendance certificates" },
        "faltasEAbandonos": { "type": "object", "description": "Absences, cancellations and abandonment metrics from reception queue" },
        "rawMarkdown": { "type": "string", "description": "Complete raw markdown response from AI" }
      },
      "required": ["patientId", "patientName", "generatedAt", "modelUsed", "resumoLongitudinal", "rawMarkdown"]
    },
    "ExamMediaReport": {
      "collection": "exam_media",
      "description": "Exam media report with up to 6 images/videos per A4 page, QR code overlay for videos, and legal retention compliance",
      "fields": {
        "id": { "type": "string", "description": "Unique report ID" },
        "patientId": { "type": "string", "description": "Patient UUID" },
        "patientName": { "type": "string", "description": "Patient name" },
        "patientAge": { "type": "string", "description": "Patient age" },
        "patientDocument": { "type": "string", "description": "CPF or CNS" },
        "title": { "type": "string", "description": "Report title (default: ANEXO ICONOGRÁFICO DE EXAMES E VÍDEOS)" },
        "examDate": { "type": "string", "description": "Date of exam (YYYY-MM-DD)" },
        "dateFormatted": { "type": "string", "description": "Formatted date" },
        "items": { "type": "array", "description": "Media items with image data, video link, video thumbnail, QR code and description" },
        "legalRetentionYears": { "type": "number", "description": "Legal retention period in years (default 20)" },
        "validUntilFormatted": { "type": "string", "description": "Legal retention expiration date" },
        "legalNotice": { "type": "string", "description": "Mandatory legal notice regarding digital retention" },
        "professionalName": { "type": "string", "description": "Professional name" },
        "professionalRole": { "type": "string", "description": "Professional role" },
        "professionalRegister": { "type": "string", "description": "Professional council register" },
        "workplace": { "type": "string", "description": "Healthcare workplace unit" },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "consultationId": { "type": "string", "description": "Optional linked consultation ID" }
      },
      "required": ["patientId", "patientName", "items", "legalRetentionYears", "validUntilFormatted", "legalNotice", "createdAt"]
    },
    "ReceptionQueueItem": {
      "collection": "reception_queue",
      "description": "Multiprofessional reception and triage waiting queue items",
      "fields": {
        "id": { "type": "string", "description": "Queue unique item ID" },
        "patientId": { "type": "string", "description": "Linked registered patient ID" },
        "patientName": { "type": "string", "description": "Patient full name" },
        "patientCpf": { "type": "string", "description": "Patient CPF document" },
        "patientCns": { "type": "string", "description": "Patient Cartão SUS / CNS" },
        "patientBirthDate": { "type": "string", "description": "Patient birth date" },
        "patientGender": { "type": "string", "description": "Patient gender" },
        "patientPhone": { "type": "string", "description": "Patient contact phone" },
        "professionalId": { "type": "string", "description": "Assigned healthcare professional User UID" },
        "professionalName": { "type": "string", "description": "Assigned healthcare professional full name" },
        "professionalProfession": { "type": "string", "description": "Assigned healthcare professional profession ID" },
        "scheduledDate": { "type": "string", "description": "Scheduled date YYYY-MM-DD" },
        "scheduledTime": { "type": "string", "description": "Scheduled time HH:mm" },
        "timestamp": { "type": "number", "description": "Queue ordering epoch timestamp in milliseconds" },
        "formattedDateTime": { "type": "string", "description": "Formatted date and time string" },
        "status": { "type": "string", "enum": ["waiting", "calling", "in_service", "in_consultation", "completed", "cancelled", "abandoned"], "description": "Queue item status" },
        "riskClassification": { "type": "string", "description": "Manchester triage risk classification (vermelho, laranja, amarelo, verde, azul)" },
        "priorityCategory": { "type": "string", "description": "Priority category (padrao, idoso_80, idoso, pcd, gestante, lactante, autismo, crianca_colo, doador)" },
        "isPregnant": { "type": "boolean", "description": "Pregnant flag" },
        "origin": { "type": "string", "description": "Queue origin (triagem, agendamento, pacientes, conclusao_atendimento)" },
        "appointmentId": { "type": "string", "description": "Optional linked appointment ID" },
        "triageSummary": { "type": "string", "description": "Triage vitals and summary notes" },
        "notes": { "type": "string", "description": "Reception intake notes" },
        "calledAt": { "type": "number", "description": "Timestamp when patient was called" },
        "createdBy": { "type": "string", "description": "User UID who added patient to queue" },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Last updated timestamp in milliseconds" }
      },
      "required": ["patientName", "professionalId", "scheduledDate", "scheduledTime", "status"]
    }
  }
}
