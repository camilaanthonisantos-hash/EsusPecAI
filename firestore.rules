rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Health / Connection check
    match /test/{docId} {
      allow read, write: if true;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'jerime.rego@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jerime.rego@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users Collection (Healthcare professionals & Administrators)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // System Settings (Global System Configuration)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Patients Collection
    match /patients/{patientId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Consultations (Prontuário PEC) Collection
    match /consultations/{consultationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Municipal Protocols & Knowledge Base
    match /knowledge_items/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // SUS & REMUME Medications Database
    match /medications/{medicationId} {
      allow read: if true;
      allow write: if true;
    }

    // SUS Official Exams & Laboratory Database
    match /exams/{examId} {
      allow read: if true;
      allow write: if true;
    }

    // Subscription Plans (Planos e Preços SaaS)
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if true;
    }

    // Subscriptions & Payments (Histórico e Intenções de PIX)
    match /subscriptions/{subscriptionId} {
      allow read: if true;
      allow write: if true;
    }

    // Appointments Collection (Módulo de Agendamentos Híbrido, Unificado e Inteligente)
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Reception Queue (Fila de Atendimento Multiprofissional)
    match /reception_queue/{itemId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Clinical Evolutions (Evolução Longitudinal com Auditoria IA)
    match /clinical_evolutions/{evolutionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Exam Media & Video QR Code Reports (Anexo Iconográfico)
    match /exam_media/{mediaId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Video streaming chunks for public citizen mobile access across instances
    match /exam_video_chunks/{chunkId} {
      allow read, write: if true;
    }
  }
}
